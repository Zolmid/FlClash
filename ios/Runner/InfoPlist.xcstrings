    "NSCameraUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ZolNit requests this permission to scan QR code."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ZolNit は QR コードをスキャンするためにこの権限が必要です。"
