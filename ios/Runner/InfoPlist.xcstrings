        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ZolNit 需要此權限以掃描 QR 碼。"
          }
        }
      }
    },
    "NSLocalNetworkUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ZolNit requests this permission to connect with servers on your local network."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ZolNit はローカルネットワーク上のサーバーに接続するためにこの権限が必要です。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ZolNit запрашивает это разрешение для подключения к серверам в вашей локальной сети."
